<?xml version='1.0' encoding='utf-8'?>
<robot name="lift2_dual_arm">
  <!-- Main file: both arms, cameras, grippers and gears are all in this URDF. mimic is a standard one-way kinematic relation; either finger can be the input and is solved by the linkage viewer/adapter in the same directory; no cyclic mimic is used. -->
  <!-- Gripper linkage revision: one open/close DOF per hand; the opposite prismatic joint and the separate gears are coupled by mimic. -->
  <!-- New platform: the ARX LIFT2 lift platform body4 without the chassis and the lift carriage (from meshes/body.STEP).
       Its frame is identical to body4 in the original lift2.urdf, so both arm mounting positions match the original robot.
       Mass keeps the original body4 value of 14.181 kg; COM/inertia computed from the body.STEP solid with uniform density. With a fixed base these values do not affect the results. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.083033 1.90443e-07 -0.0320664" rpy="0 0 0" />
      <mass value="14.181" />
      <inertia ixx="0.472429" ixy="-1.36781e-07" ixz="-0.00314007" iyy="0.0520179" iyz="-8.58581e-07" izz="0.461517" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/platform_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/platform_link.STL" />
      </geometry>
    </collision>
    <!-- Left arm J1 mounting boss (cut from the original body4.STL, position unchanged), seated in the platform Ø80 counterbore; top face Z=26.5 mm -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/left_arm_mount.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/left_arm_mount.STL" />
      </geometry>
    </collision>
    <!-- Right arm J1 mounting boss (cut from the original body4.STL, position unchanged), seated in the platform Ø80 counterbore; top face Z=26.5 mm -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/right_arm_mount.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/right_arm_mount.STL" />
      </geometry>
    </collision>
  </link>
